<?xml version="1.0" encoding="utf-8"?>
<!-- 网络安全配置，注意：修改host时需要同时更新 lib/utils/api_config.dart 中的 host 配置 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Render 生产环境域名配置 -->
    <domain-config>
        <domain includeSubdomains="true">fitnessapp-rxlv.onrender.com</domain>
    </domain-config>
    <!-- 开发环境局域网IP配置，如需修改请同时修改 lib/utils/api_config.dart -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.82.70.93</domain>
    </domain-config>
    <!-- 可选：添加本地开发配置 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.0.0/8</domain>
        <domain includeSubdomains="true">172.16.0.0/12</domain>
        <domain includeSubdomains="true">192.168.0.0/16</domain>
    </domain-config>
</network-security-config>
